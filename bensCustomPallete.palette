  <!-- /BensCustomWidgets/maxMinusNcalc -->
  <p n="maxMinusNcalc" h="5d" t="p:Program">
   <p n="code" h="79" t="p:ProgramCode">
    <p n="className" v="Prog_9a4b512a06ec4736a6d9320457a4a960"/>
    <p n="classFile" t="b:Blob" v=""/>
    <p n="dependencies" v="program-rt;nre;baja"/>
    <p n="checksum" v="-1953072823"/>
    <p n="source" v="Clock.Ticket ticket; // Timer&#xa;&#xa;public void onStart() throws Exception {&#xa;&#xa;&#xa;    // Schedule logic to run periodically&#xa;    updateTimer();&#xa;}&#xa;&#xa;&#xa;public void onExecute() throws Exception {&#xa;    updateTimer(); // Reschedule every X seconds&#xa;&#xa;    BStatusNumeric[] inputs = {&#xa;        getIn1(), getIn2(), getIn3(), getIn4(), getIn5(),&#xa;        getIn6(), getIn7(), getIn8(), getIn9(), getIn10(),&#xa;        getIn11(), getIn12(), getIn13(), getIn14(), getIn15(),&#xa;        getIn16(), getIn17(), getIn18(), getIn19(), getIn20(),&#xa;        getIn21(), getIn22(), getIn23(), getIn24(), getIn25(),&#xa;        getIn26(), getIn27(), getIn28(), getIn29(), getIn30()&#xa;    };&#xa;&#xa;    // Step 1: Null disconnected inputs&#xa;    for (int i = 0; i &lt; inputs.length; i++) {&#xa;        if (getComponent().getLinks(getComponent().getSlot(&#x22;in&#x22; + (i + 1))).length == 0) {&#xa;            inputs[i].setValue(0);&#xa;            inputs[i].setStatus(BStatus.NULL);&#xa;        }&#xa;    }&#xa;&#xa;    BStatusNumeric nInput = getIgnoreCount();  // N = # of top values to ignore&#xa;    BStatusNumeric maxOut = getFilteredMax();  // Output after filtering top N&#xa;&#xa;    if (!nInput.getStatus().isOk()) {&#xa;        System.out.println(&#x22;Ignore count input (N) invalid.&#x22;);&#xa;        maxOut.setValue(0.0);&#xa;        return;&#xa;    }&#xa;&#xa;    int n = (int) nInput.getValue();&#xa;&#xa;    // Step 2: Collect valid inputs&#xa;    ArrayList&lt;Double&gt; validValues = new ArrayList&lt;&gt;();&#xa;    for (BStatusNumeric input : inputs) {&#xa;        if (input.getStatus().isOk()) {&#xa;            validValues.add(input.getValue());&#xa;        }&#xa;    }&#xa;&#xa;    if (validValues.isEmpty()) {&#xa;        System.out.println(&#x22;No valid VAV inputs.&#x22;);&#xa;        maxOut.setValue(0.0);&#xa;        return;&#xa;    }&#xa;&#xa;    // Step 3: Sort and filter&#xa;    validValues.sort(Collections.reverseOrder());&#xa;&#xa;    int valuesToConsider = Math.max(0, validValues.size() - n);&#xa;    if (valuesToConsider == 0) {&#xa;        maxOut.setValue(0.0);&#xa;        System.out.println(&#x22;After ignoring top N, no values remain.&#x22;);&#xa;        return;&#xa;    }&#xa;&#xa;    double filteredMax = validValues.get(n);&#xa;    maxOut.setValue(filteredMax);&#xa;    System.out.println(&#x22;Filtered Max (N=&#x22; + n + &#x22;) = &#x22; + filteredMax);&#xa;}&#xa;&#xa;public void onStop() throws Exception {&#xa;    if (ticket != null) ticket.cancel();&#xa;}&#xa;&#xa;public BComponent getProgram() {&#xa;    return (BComponent) getComponent();&#xa;}&#xa;&#xa;void updateTimer() {&#xa;    if (ticket != null) ticket.cancel();&#xa;&#xa;    BStatusNumeric intervalInput = getUpdateIntervalSeconds();&#xa;    int interval = 300; // Default interval (seconds)&#xa;&#xa;    if (intervalInput.getStatus().isOk()) {&#xa;        double val = intervalInput.getValue();&#xa;        interval = (int) Math.max(10, Math.min(val, 3600)); // Clamp between 10s and 1hr&#xa;    }&#xa;&#xa;    getWorkingUpdateInterval().setValue(interval);&#xa;    ticket = Clock.schedule(getProgram(), BRelTime.makeSeconds(interval), BProgram.execute, null);&#xa;}&#xa;"/>
   </p>
