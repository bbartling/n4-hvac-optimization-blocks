    <p n="vavDprPos13" f="sL" t="b:StatusNumeric"><p n="value" v="64.19905090332031"/></p>
    <p n="vavDprPos14" f="sL" t="b:StatusNumeric"><p n="value" v="0.0"/><p n="status" v="40"/></p>
    <p n="vavDprPos15" f="sL" t="b:StatusNumeric"><p n="value" v="0.0"/><p n="status" v="40"/></p>
    <p n="vavDprPos16" f="s" t="b:StatusNumeric"><p n="value" v="0.0"/><p n="status" v="40;activeLevel=e:17@control:PriorityLevel"/></p>
    <p n="vavDprPos17" f="s" t="b:StatusNumeric"><p n="value" v="0.0"/><p n="status" v="40;activeLevel=e:17@control:PriorityLevel"/></p>
    <p n="vavDprPos18" f="sL" t="b:StatusNumeric"><p n="value" v="0.0"/><p n="status" v="40"/></p>
    <p n="vavDprPos19" f="s" t="b:StatusNumeric"><p n="value" v="0.0"/><p n="status" v="40;activeLevel=e:17@control:PriorityLevel"/></p>
    <p n="vavDprPos20" f="s" t="b:StatusNumeric"><p n="value" v="0.0"/><p n="status" v="40"/></p>
    <p n="vavDprPos21" f="s" t="b:StatusNumeric"><p n="value" v="0.0"/><p n="status" v="40;activeLevel=e:17@control:PriorityLevel"/></p>
    <p n="vavDprPos22" f="s" t="b:StatusNumeric"><p n="value" v="0.0"/><p n="status" v="40"/></p>
    <p n="vavDprPos23" f="s" t="b:StatusNumeric"><p n="value" v="0.0"/><p n="status" v="40;activeLevel=e:17@control:PriorityLevel"/></p>
