  <!-- /BensCustomWidgets/TextBlock -->
  <p n="TextBlock" h="63" t="b:WsTextBlock">
   <p n="text" v="Filter MAX block - IE., if there are 30 air dampers or coils&#xa;Wire in all of them and take a filtered max value&#xa;&#xa;Used in a lot of ASHRAE Guideline 36 logic&#xa;&#xa;"/>
   <p n="wsAnnotation" t="b:WsAnnotation" v="27,5,29,5"/>
  </p>
  <!-- /BensCustomWidgets/TextBlock1 -->
  <p n="TextBlock1" h="64" t="b:WsTextBlock">
   <p n="text" v="This block starts the chiller if max valve signal&#xa;is greater than 30 and shuts off chiller if max valve&#xa;less than 10"/>
   <p n="wsAnnotation" t="b:WsAnnotation" v="72,36,29,5"/>
  </p>
  <!-- /BensCustomWidgets/TextBlock2 -->
  <p n="TextBlock2" h="65" t="b:WsTextBlock">
   <p n="text" v="TODO - expand this for AHU system&#xa;take filtered MAX and create new block for&#xa;AHU duct static pressure trim respond&#xa;&#xa;and AHU leaving air tempreature trim respond&#xa;based off of similar logic&#xa;&#xa;Usually about 30 inputs are needed per AHU &#xa;system&#xa;&#xa;And block only needs to update values once every&#xa;5 minutes"/>
   <p n="wsAnnotation" t="b:WsAnnotation" v="83,8,29,16"/>
  </p>
  <!-- /BensCustomWidgets/TextBlock3 -->
  <p n="TextBlock3" h="66" t="b:WsTextBlock">
   <p n="text" v="Guideline 36 only needs update &#xa;every 300 seconds"/>
   <p n="wsAnnotation" t="b:WsAnnotation" v="7,60,20,4"/>
  </p>
  <p n="wsAnnotation" t="b:WsAnnotation" v="24,29,8"/>
  <!-- /BensCustomWidgets/ahuDuctStaticReset -->
  <p n="ahuDuctStaticReset" h="b4" t="p:Program">
   <p n="code" h="b5" t="p:ProgramCode">
    <p n="className" v="Prog_9e193908f0084a81a7af682ef457dd7a"/>
    <p n="classFile" t="b:Blob" v=""/>
    <p n="dependencies" v="program-rt;nre;baja"/>
    <p n="checksum" v="699299044"/>
    <p n="source" v="Clock.Ticket ticket;&#xa;&#xa;boolean fanWasOff = true;&#xa;long fanOnTimestamp = 0;&#xa;long lastMainLogicRun = 0; // to track elapsed time since last AHU logic run&#xa;&#xa;public void onStart() throws Exception {&#xa;    // Set default tuning values&#xa;    getTrimRespVal().setValue(0.1);&#xa;    getDuctPressMin().setValue(0.5);&#xa;    getDuctPressMax().setValue(1.2);&#xa;    getStartupLagSeconds().setValue(600);&#xa;    getAhuDuctPressStpOut().setValue(1.2);&#xa;    getActiveUpdateInterval().setValue(300.0);&#xa;&#xa;    lastMainLogicRun = System.currentTimeMillis();&#xa;&#xa;    updateTimer(); // Start the 10s base loop&#xa;}&#xa;&#xa;public void onExecute() throws Exception {&#xa;    updateTimer(); // Reschedule every 10s&#xa;&#xa;    // --- Always run this: VAV NULL check ---&#xa;    BStatusNumeric[] vavDprInputs = {&#xa;        getVavDprPos1(), getVavDprPos2(), getVavDprPos3(), getVavDprPos4(), getVavDprPos5(),&#xa;        getVavDprPos6(), getVavDprPos7(), getVavDprPos8(), getVavDprPos9(), getVavDprPos10(),&#xa;        getVavDprPos11(), getVavDprPos12(), getVavDprPos13(), getVavDprPos14(), getVavDprPos15(),&#xa;        getVavDprPos16(), getVavDprPos17(), getVavDprPos18(), getVavDprPos19(), getVavDprPos20(),&#xa;        getVavDprPos21(), getVavDprPos22(), getVavDprPos23(), getVavDprPos24(), getVavDprPos25(),&#xa;        getVavDprPos26(), getVavDprPos27(), getVavDprPos28(), getVavDprPos29(), getVavDprPos30()&#xa;    };&#xa;&#xa;    for (int i = 0; i &lt; vavDprInputs.length; i++) {&#xa;        if (getComponent().getLinks(getComponent().getSlot(&#x22;vavDprPos&#x22; + (i + 1))).length == 0) {&#xa;            vavDprInputs[i].setValue(0);&#xa;            vavDprInputs[i].setStatus(BStatus.NULL);&#xa;        }&#xa;    }&#xa;&#xa;    // --- Run AHU logic based on update interval ---&#xa;    long now = System.currentTimeMillis();&#xa;    int intervalSec = 300;&#xa;    BStatusNumeric intervalInput = getUpdateIntervalSeconds();&#xa;&#xa;    if (intervalInput.getStatus().isOk()) {&#xa;        double raw = intervalInput.getValue();&#xa;        intervalSec = (int) Math.max(10, Math.min(raw, 3600)); // Clamp to 10&#x2013;3600 seconds&#xa;    }&#xa;&#xa;    getActiveUpdateInterval().setValue(intervalSec);&#xa;&#xa;    if ((now - lastMainLogicRun) / 1000 &lt; intervalSec) {&#xa;        return;&#xa;    }&#xa;&#xa;    lastMainLogicRun = now;&#xa;&#xa;    // --- Validate and clamp tuning inputs ---&#xa;    int ignoreCount = 0;&#xa;    BStatusNumeric nInput = getIgnoreCount();&#xa;    if (nInput.getStatus().isOk()) {&#xa;        ignoreCount = (int) Math.max(0, Math.min(nInput.getValue(), 30));&#xa;    }&#xa;&#xa;    double trimIncrement = Math.max(0.0, getTrimRespVal().getValue()); // No upper limit needed&#xa;    double minPress = Math.max(0.0, Math.min(getDuctPressMin().getValue(), 10.0));&#xa;    double maxPress = Math.max(0.0, Math.min(getDuctPressMax().getValue(), 10.0));&#xa;    int lagSeconds = (int) Math.max(0, Math.min(getStartupLagSeconds().getValue(), 3600));&#xa;&#xa;    // --- Collect valid damper values ---&#xa;    BStatusNumeric vavDprFilteredMax = getVavDprFilteredMax();&#xa;    ArrayList&lt;Double&gt; validValues = new ArrayList&lt;&gt;();&#xa;    &#xa;    for (BStatusNumeric input : vavDprInputs) {&#xa;        if (input.getStatus().isOk()) {&#xa;            validValues.add(input.getValue());&#xa;        }&#xa;    }&#xa;    &#xa;    // ---- VAV Damper Filtering ---&#xa;    if (validValues.isEmpty() || validValues.size() &lt;= ignoreCount) {&#xa;        getVavDprFilteredMax().setValue(0.0);&#xa;        getVavDprFilteredAvg().setValue(0.0);&#xa;        getAhuDuctPressStpOut().setValue(maxPress);&#xa;        return;&#xa;    }&#xa;    &#xa;    // Filtered list after ignoring top N&#xa;    validValues.sort(Collections.reverseOrder());&#xa;    List&lt;Double&gt; filtered = validValues.subList(ignoreCount, validValues.size());&#xa;    &#xa;    // Avg of remaining&#xa;    double sum = 0.0;&#xa;    for (double val : filtered) {&#xa;        sum += val;&#xa;    }&#xa;    double vavAvg = sum / filtered.size();&#xa;    &#xa;    // Max is first item in sorted filtered list&#xa;    double vavMax = filtered.get(0);&#xa;    &#xa;    // Write to output slots&#xa;    getVavDprFilteredMax().setValue(vavMax);&#xa;    getVavDprFilteredAvg().setValue(vavAvg);&#xa;&#xa;    // --- Trim &amp; Respond ---&#xa;    BStatusBoolean fanStatus = getAhuFanStatus();&#xa;    BStatusNumeric pressSetpoint = getAhuDuctPressStpOut();&#xa;    double currentSP = pressSetpoint.getStatus().isOk() ? pressSetpoint.getValue() : maxPress;&#xa;    boolean fanOn = fanStatus.getValue();&#xa;    &#xa;    if (!fanOn) {&#xa;        fanWasOff = true;&#xa;        fanOnTimestamp = 0;&#xa;        pressSetpoint.setValue(maxPress);&#xa;        System.out.println(&#x22;Fan OFF &#x2192; setpoint = MAX&#x22;);&#xa;        return;&#xa;    }&#xa;    &#xa;    if (fanWasOff) {&#xa;        fanWasOff = false;&#xa;        fanOnTimestamp = now;&#xa;        pressSetpoint.setValue(maxPress);&#xa;        System.out.println(&#x22;Fan ON startup &#x2192; hold MAX&#x22;);&#xa;        return;&#xa;    }&#xa;    &#xa;    if ((now - fanOnTimestamp) / 1000 &lt; lagSeconds) {&#xa;        pressSetpoint.setValue(maxPress);&#xa;        System.out.println(&#x22;Startup lag active &#x2192; hold MAX&#x22;);&#xa;        return;&#xa;    }&#xa;    &#xa;    if (vavMax &gt;= 90.0) {&#xa;        currentSP = Math.min(currentSP + trimIncrement, maxPress);&#xa;        System.out.println(&#x22;Trim up: &#x22; + currentSP);&#xa;    } else if (vavMax &lt;= 80.0) {&#xa;        currentSP = Math.max(currentSP - trimIncrement, minPress);&#xa;        System.out.println(&#x22;Respond down: &#x22; + currentSP);&#xa;    } else {&#xa;        System.out.println(&#x22;Hold: within neutral zone&#x22;);&#xa;    }&#xa;    &#xa;    pressSetpoint.setValue(currentSP);&#xa;&#xa;}&#xa;&#xa;public void onStop() throws Exception {&#xa;    if (ticket != null) ticket.cancel();&#xa;}&#xa;&#xa;public BComponent getProgram() {&#xa;    return (BComponent) getComponent();&#xa;}&#xa;&#xa;void updateTimer() {&#xa;    if (ticket != null) ticket.cancel();&#xa;    ticket = Clock.schedule(getProgram(), BRelTime.makeSeconds(10), BProgram.execute, null);&#xa;}&#xa;"/>
   </p>
