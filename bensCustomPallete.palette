     <!-- /Optimization/RTU7/leavTempStpReset/Rtu7TempStpOutVal/NumericInterval -->
     <p n="NumericInterval" h="2db" t="h:NumericIntervalHistoryExt">
      <p n="historyConfig" h="2dc" t="h:HistoryConfig">
       <p n="source" t="b:OrdList" v="station:|slot:/Optimization/leavTempStpReset/TempStpOutVal/NumericInterval"/>
       <p n="sourceHandle" t="b:Ord" v="h:2db"/>
       <p n="recordType" t="b:TypeSpec" v="history:NumericTrendRecord"/>
       <p n="schema" t="h:HistorySchema" v="timestamp,baja:AbsTime;trendFlags,history:TrendFlags;status,baja:Status;value,baja:Double"/>
       <p n="interval" t="h:CollectionInterval" v="false:900000"/>
