    <!-- /Optimization/RTU8/leavTempStpReset/TextBlock -->
    <p n="TextBlock" h="320" t="b:WsTextBlock">
     <p n="text" v="This setpoint value block is discovered to the RTU Jace&#xa;via the Niagara network"/>
     <p n="wsAnnotation" t="b:WsAnnotation" v="102,46,29,5"/>
    </p>
    <!-- /Optimization/RTU8/leavTempStpReset/TextBlock1 -->
    <p n="TextBlock1" h="321" t="b:WsTextBlock">
     <p n="text" v="AHU Supply Air Temperature Reset Program (Trim &amp; Respond &#x2013; Insprired by ASHRAE Guideline 36)&#xa;&#xa;&#x2022; This logic resets the AHU discharge air temp setpoint based on VAV zone demand value calculated by the VAV box.&#xa;&#xa;&#x2022; It evaluates all connected VAV box demand values (up to 30):&#xa;  - If VAV Max &#x2265; 30%, the SAT is trimmed **colder**.&#xa;  - If VAV Max &#x2264; 10%, the SAT is relaxed **warmer**.&#xa;  - If in between, the SAT is held steady (neutral zone).&#xa;&#xa;&#x2022; The highest outlier(s) can be excluded using the **Ignore Count**, which helps ignore rogue or misbehaving zones.&#xa;&#xa;&#x2022; If the AHU fan is OFF or in Startup Lag, the SAT will be forced to a **Startup SAT Setpoint**.&#xa;&#xa;&#x2022; If Outside Air Temperature exceeds a high limit (for constant 55F in hot summer), SAT is **locked to minimum** to prevent humidity issues.&#xa;&#xa;&#x2022; All values are clamped within SAT min/max limits."/>
     <p n="wsAnnotation" t="b:WsAnnotation" v="1,2,66,27"/>
    </p>
    <!-- /Optimization/RTU8/leavTempStpReset/TextBlock2 -->
    <p n="TextBlock2" h="322" t="b:WsTextBlock">
     <p n="text" v="Small VAV systems less than 10 boxes set to 0 ignore values.&#xa;Typical VAV systems 10 - 30 boxes maybe 1 or 2 ignore values.&#xa;Large VAV systems greater than 30 set 2+ ignore values.&#xa;"/>
     <p n="wsAnnotation" t="b:WsAnnotation" v="9,36,29,5"/>
    </p>
    <!-- /Optimization/RTU8/leavTempStpReset/startUpLag -->
    <p n="startUpLag" h="323" t="c:NumericWritable">
     <p n="fallback" t="b:StatusNumeric"><p n="value" v="120.0"/></p>
     <p n="wsAnnotation" t="b:WsAnnotation" v="9,69,12"/>
    </p>
